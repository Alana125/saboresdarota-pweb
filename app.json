{
  "expo": {
    "name": "sabores-da-rota-Alana_e_Lyvia",
    "slug": "sabores-da-rota-Alana_e_Lyvia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/splash.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "sabores-da-rota-Alana_e_Lyvia",
    "experiments": {
      "typedRouter": true
    },
    "splash": {
      "image": "./assets/iconsabores.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
